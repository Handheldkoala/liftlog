rules_version = '2';
// Paste this into Firebase console → Firestore Database → Rules, then press Publish.
service cloud.firestore {
  match /databases/{database}/documents {
    // Each account can read and write only its own training data.
    match /users/{uid}/{rest=**} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
    // Anyone using the app can send feedback; nobody can read it from the app (read it in the Firebase console).
    match /feedback/{id} {
      allow create: if request.resource.data.keys().hasOnly(['text', 'kind', 'v', 'uid', 'ts'])
        && request.resource.data.text is string
        && request.resource.data.text.size() > 0
        && request.resource.data.text.size() <= 4000;
    }
  }
}
